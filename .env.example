# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/ticket_helper

# Better Auth Configuration
BETTER_AUTH_SECRET=generate-a-random-32-char-secret-min
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Initial Admin Credentials (for db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Super Admin

# AI Provider
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=

# Email Gateway
RESEND_API_KEY=
EMAIL_FROM=support@yourdomain.com
WEBHOOK_SIGNING_SECRET=

# Sentry Error Logging
# Server Sentry DSN (Node SDK)
SENTRY_DSN=
# Frontend Sentry DSN (React SDK)
VITE_SENTRY_DSN=
