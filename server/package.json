{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "start": "bun dist/index.js",
    "db:generate": "bun prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "bun prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "bun src/db/seed.ts",
    "db:seed:tickets": "bun src/db/seed-tickets.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.1.9",
    "@ai-sdk/openai": "^1.1.0",
    "@prisma/client": "^6.4.1",
    "@sentry/node": "^11.9.0",
    "ai": "^4.1.20",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.7.6",
    "cookie-parser": "^1.4.7",
    "core": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg-boss": "^12.38.0",
    "prisma": "^6.4.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
