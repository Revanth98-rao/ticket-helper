# ==============================================================================
# Railway Production Environment Variables Configuration Template
# ==============================================================================

# Node / Environment
NODE_ENV=production
# PORT is automatically injected by Railway, but can be set to 5000 as a fallback
PORT=5000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Automatically provided by Railway when attaching a PostgreSQL database plugin:
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ------------------------------------------------------------------------------
# Better Auth Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random secret (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=generate-a-strong-32-character-secret-for-production

# Point to your Railway public domain or custom domain
# On Railway, you can reference ${{RAILWAY_PUBLIC_DOMAIN}}:
BETTER_AUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}

# ------------------------------------------------------------------------------
# Initial Admin Credentials (used during initial database seed)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-to-a-strong-password123!
ADMIN_NAME=Super Admin

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
GEMINI_POLISH_MODEL=gemini-2.5-flash

# Optional: OpenAI alternative
# OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# Email Gateway (Resend / Postmark / Inbound Webhooks)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=support@yourdomain.com
WEBHOOK_SIGNING_SECRET=your-inbound-webhook-secret

# ------------------------------------------------------------------------------
# Sentry Error Logging
# ------------------------------------------------------------------------------
SENTRY_DSN=your-sentry-server-dsn
VITE_SENTRY_DSN=your-sentry-client-dsn
SENTRY_ENVIRONMENT=production

